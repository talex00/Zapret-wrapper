<UserControl x:Class="ZapretWrapper.Views.TestingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ZapretWrapper.Controls"
             Loaded="Reveal_Loaded">

    <!--
        Тот же принцип, что и на главной: блок появляется, когда ему есть что показать.

        До первого запуска на странице только кнопка. Кольца метрик включаются привязкой
        (пока в них прочерки — карточка свёрнута), таблица результатов — из TestingPage.Reveal.cs,
        когда строки начали заполняться. Методика и журнал убраны под Expander: они нужны
        при разборе проблем, а не при каждом прогоне.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center">

            <!-- Шаг 1: запуск. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Подбор стратегии"
                               Style="{StaticResource TextCardTitleStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Text="Каждая стратегия проверяется реальными запросами. Обход на время проверки будет остановлен." />

                    <Button x:Name="TestToggleButton"
                            Content="🔍  Запустить тестирование"
                            Style="{StaticResource AccentButtonStyle}"
                            MinHeight="44"
                            Margin="0,14,0,0"
                            Click="TestToggle_Click" />

                    <TextBlock x:Name="ProgressText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,10,0,0" />

                    <Expander Header="Что именно проверяется" Margin="0,12,0,0">
                        <StackPanel Margin="2,10,2,0">
                            <TextBlock Style="{StaticResource TextMutedStyle}"
                                       TextWrapping="Wrap"
                                       Text="TLS-хендшейк с проверкой сертификата, код ответа HTTPS и проход UDP через STUN. Первая строка результатов — замер без обхода для сравнения." />

                            <TextBlock Text="Целевые ресурсы:"
                                       Style="{StaticResource TextLabelStyle}"
                                       Margin="0,12,0,8" />
                            <WrapPanel x:Name="TargetsPanel" />

                            <TextBlock x:Name="SourceText"
                                       Style="{StaticResource TextSubtleStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!--
                Шаг 2: метрики. Видимостью управляет привязка к самим кольцам:
                пока ResetRings держит в них «—», показывать нечего.
            -->
            <Border x:Name="MetricsCard" Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Value, ElementName=SuccessRing}" Value="—" />
                                    <Condition Binding="{Binding Value, ElementName=ChecksRing}" Value="—" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="По лучшей стратегии"
                               Style="{StaticResource TextMutedStyle}"
                               Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="8">
                            <ctrl:MetricRing x:Name="PingRing"
                                             Value="—"
                                             Caption="Средний отклик"
                                             ArcBrush="{DynamicResource PingBrush}"
                                             Progress="0" />
                        </Grid>
                        <Grid Grid.Column="1" Margin="8">
                            <ctrl:MetricRing x:Name="SuccessRing"
                                             Value="—"
                                             Caption="Успешность"
                                             ArcBrush="{DynamicResource LossBrush}"
                                             Progress="0" />
                        </Grid>
                        <Grid Grid.Column="2" Margin="8">
                            <ctrl:MetricRing x:Name="ChecksRing"
                                             Value="—"
                                             Caption="Проверки"
                                             ArcBrush="{DynamicResource SpeedBrush}"
                                             Progress="0" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Шаг 3: таблица. Раскрывается, когда по строкам пошли данные. -->
            <Border x:Name="ResultsCard"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Результаты"
                                   Style="{StaticResource TextCardTitleStyle}"
                                   Margin="0" />
                        <TextBlock x:Name="BestStrategyText"
                                   Grid.Column="1"
                                   Text=""
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Заголовки таблицы. SharedSizeGroup держит колонки выровненными со строками. -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="ColName" MinWidth="170" />
                                <ColumnDefinition SharedSizeGroup="ColStatus" MinWidth="120" />
                                <ColumnDefinition SharedSizeGroup="ColPing" MinWidth="90" />
                                <ColumnDefinition SharedSizeGroup="ColRate" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Стратегия" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Статус" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Отклик" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Успешно" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Детали" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Раньше здесь был DataGrid: он обрезал детали по высоте строки и
                         съедал колёсико мыши. ItemsControl растёт по содержимому. -->
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="ColName" MinWidth="170" />
                                            <ColumnDefinition SharedSizeGroup="ColStatus" MinWidth="120" />
                                            <ColumnDefinition SharedSizeGroup="ColPing" MinWidth="90" />
                                            <ColumnDefinition SharedSizeGroup="ColRate" MinWidth="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PingText}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SuccessText}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Details}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Журнал нужен при разборе проблем, а не при каждом прогоне. -->
            <Expander Header="Журнал тестирования" Margin="0,14,0,0">
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="2,10,2,0"
                        Padding="12">
                    <ScrollViewer x:Name="LogScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  MaxHeight="260">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
