<UserControl x:Class="ZapretWrapper.Views.TestingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ZapretWrapper.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Тестирование стратегий"
                               Style="{StaticResource TextCardTitleStyle}" />
                    <TextBlock Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Text="Каждая стратегия запускается по очереди и проверяется реальными пробами: TLS-хендшейк с проверкой сертификата, код ответа HTTPS и проход UDP через STUN. Первая строка — замер без обхода для сравнения."
                               Margin="0,0,0,12" />

                    <TextBlock Text="Целевые ресурсы:"
                               Style="{StaticResource TextLabelStyle}" />
                    <WrapPanel x:Name="TargetsPanel" Margin="0,0,0,8" />

                    <TextBlock x:Name="SourceText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Button x:Name="TestToggleButton"
                            Content="🔍  Запустить тестирование"
                            Click="TestToggle_Click" />

                    <TextBlock x:Name="ProgressText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Сетевая статистика (по лучшей стратегии)"
                               Style="{StaticResource TextCardTitleStyle}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="8">
                            <ctrl:MetricRing x:Name="PingRing"
                                             Value="—"
                                             Caption="Средний отклик"
                                             ArcBrush="{DynamicResource PingBrush}"
                                             Progress="0" />
                        </Grid>
                        <Grid Grid.Column="1" Margin="8">
                            <ctrl:MetricRing x:Name="SuccessRing"
                                             Value="—"
                                             Caption="Успешность"
                                             ArcBrush="{DynamicResource LossBrush}"
                                             Progress="0" />
                        </Grid>
                        <Grid Grid.Column="2" Margin="8">
                            <ctrl:MetricRing x:Name="ChecksRing"
                                             Value="—"
                                             Caption="Проверки"
                                             ArcBrush="{DynamicResource SpeedBrush}"
                                             Progress="0" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Результаты тестирования"
                                   Style="{StaticResource TextCardTitleStyle}"
                                   Margin="0" />
                        <TextBlock x:Name="BestStrategyText"
                                   Grid.Column="1"
                                   Text=""
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Заголовки таблицы. SharedSizeGroup держит колонки выровненными со строками. -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="ColName" MinWidth="170" />
                                <ColumnDefinition SharedSizeGroup="ColStatus" MinWidth="120" />
                                <ColumnDefinition SharedSizeGroup="ColPing" MinWidth="90" />
                                <ColumnDefinition SharedSizeGroup="ColRate" MinWidth="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Стратегия" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Статус" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Отклик" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Успешно" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Детали" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Раньше здесь был DataGrid: он обрезал детали по высоте строки и
                         съедал колёсико мыши. ItemsControl растёт по содержимому. -->
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="ColName" MinWidth="170" />
                                            <ColumnDefinition SharedSizeGroup="ColStatus" MinWidth="120" />
                                            <ColumnDefinition SharedSizeGroup="ColPing" MinWidth="90" />
                                            <ColumnDefinition SharedSizeGroup="ColRate" MinWidth="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PingText}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SuccessText}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Details}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Журнал тестирования"
                               Style="{StaticResource TextCardTitleStyle}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <ScrollViewer x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      MaxHeight="260">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
