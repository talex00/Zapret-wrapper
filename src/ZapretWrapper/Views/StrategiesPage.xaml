<UserControl x:Class="ZapretWrapper.Views.StrategiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Стратегии обхода"
                       Style="{StaticResource TextCardTitleStyle}" />
            <TextBlock Style="{StaticResource TextMutedStyle}"
                       Text="Встроенные пресеты. Выбор стратегии делается на главной странице."
                       Margin="0,0,0,16" />

            <ItemsControl x:Name="StrategyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource TextMutedStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding RecommendedFor}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PillBorderStyle}">
                                                    <TextBlock Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
