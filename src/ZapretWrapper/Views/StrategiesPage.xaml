<UserControl x:Class="ZapretWrapper.Views.StrategiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     >
    <Grid>
        <Border Style="{StaticResource CardBorderStyle}"
                Margin="20"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Стратегии"
                           Style="{StaticResource TextCardTitleStyle}" />
                <TextBlock Text="Здесь будет список стратегий и редактор параметров."
                           Style="{StaticResource TextMutedStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
