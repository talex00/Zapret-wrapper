<UserControl x:Class="ZapretWrapper.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ZapretWrapper.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Быстрый запуск"
                               Style="{StaticResource TextCardTitleStyle}" />

                    <TextBlock Text="Выберите стратегию:"
                               Style="{StaticResource TextLabelStyle}" />
                    <ComboBox x:Name="StrategyCombo"
                              SelectionChanged="StrategyCombo_SelectionChanged">
                        <ComboBoxItem Content="auto_qq (Рекомендуется)" Tag="auto_qq" IsSelected="True" />
                        <ComboBoxItem Content="youtube_qq" Tag="youtube_qq" />
                        <ComboBoxItem Content="general_tcp" Tag="general_tcp" />
                        <ComboBoxItem Content="udp_fragment" Tag="udp_fragment" />
                        <ComboBoxItem Content="tls_fake_sni" Tag="tls_fake_sni" />
                    </ComboBox>

                    <TextBlock Text="Целевые ресурсы:"
                               Style="{StaticResource TextLabelStyle}"
                               Margin="0,16,0,8" />
                    <WrapPanel x:Name="TargetResourcesPanel" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="StartButton"
                                Content="▶  Запустить обход"
                                Click="Start_Click" />
                        <Button Grid.Column="2"
                                x:Name="StopButton"
                                Content="■  Остановить"
                                Click="Stop_Click" />
                        <Button Grid.Column="4"
                                x:Name="TestButton"
                                Content="🔍  Тест всех"
                                Click="TestAll_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" MinHeight="240">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Сетевая статистика"
                               Style="{StaticResource TextCardTitleStyle}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="8">
                            <ctrl:MetricRing Value="—"
                                             Caption="Пинг"
                                             ArcBrush="{DynamicResource PingBrush}"
                                             Progress="0" />
                        </Grid>
                        <Grid Grid.Column="1" Margin="8">
                            <ctrl:MetricRing Value="—"
                                             Caption="Потери"
                                             ArcBrush="{DynamicResource LossBrush}"
                                             Progress="0" />
                        </Grid>
                        <Grid Grid.Column="2" Margin="8">
                            <ctrl:MetricRing Value="—"
                                             Caption="Скорость"
                                             ArcBrush="{DynamicResource SpeedBrush}"
                                             Progress="0" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Результаты тестирования"
                                   Style="{StaticResource TextCardTitleStyle}"
                                   Margin="0" />
                        <TextBlock x:Name="BestStrategyText"
                                   Grid.Column="1"
                                   Text=""
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название стратегии"
                                                Binding="{Binding Name}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding StatusText}"
                                                Width="1.4*" />
                            <DataGridTextColumn Header="Пинг (мс)"
                                                Binding="{Binding PingText}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="Успех"
                                                Binding="{Binding LossText}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="Среднее (мс)"
                                                Binding="{Binding SpeedText}"
                                                Width="1.1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Журнал событий"
                                   Style="{StaticResource TextCardTitleStyle}"
                                   Margin="0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SubtleButtonStyle}"
                                Content="Очистить"
                                Click="ClearLog_Click" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <ScrollViewer x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      MaxHeight="240">
                            <StackPanel x:Name="LogPanel" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
