<UserControl x:Class="ZapretWrapper.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Прогрессивное раскрытие: на экране одновременно живёт только тот шаг,
        для которого уже есть данные.

        Карточка больше не ограничена шириной в центре большого окна: в простом
        режиме окно само размером с карточку (480x420, см. MainWindow.xaml).
        MaxWidth оставлен только для того случая, когда главную открывают в широком
        расширенном режиме — там растягивать её на всю ширину некрасиво.

        Текста ровно столько, сколько нужно для решения. Всё объясняющее
        (описание стратегии, источник, аргументы, журнал) — в «Подробностях».
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="14,12,14,12">

            <!-- ШАГ 1: пока нет валидной папки — только она. -->
            <Border x:Name="PathCard"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Укажите папку zapret"
                               Style="{StaticResource TextCardTitleStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Text="Распакованный zapret-discord-youtube или zapret2." />

                    <Button Content="Выбрать папку…"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            Click="ChoosePath_Click" />

                    <TextBlock x:Name="PathText"
                               Style="{StaticResource TextSubtleStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="PathProblemText"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ШАГ 2: папка есть — стратегия и запуск. Главное действие. -->
            <Border x:Name="LaunchCard"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="18"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DetectedText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <ComboBox x:Name="StrategyCombo"
                              DisplayMemberPath="Name"
                              MinHeight="38"
                              SelectionChanged="StrategyCombo_SelectionChanged" />

                    <Button x:Name="ActionButton"
                            Content="▶  Запустить обход"
                            Style="{StaticResource AccentButtonStyle}"
                            FontSize="14"
                            MinHeight="46"
                            Margin="0,12,0,0"
                            Click="Action_Click" />

                    <TextBlock x:Name="StateText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,10,0,0" />

                    <!-- Подстраховка для тех, кто не знает, что выбрать. Строкой, не карточкой. -->
                    <StackPanel x:Name="AutoPickCard"
                                Visibility="Collapsed"
                                Margin="0,12,0,0">
                        <Border Background="{DynamicResource BorderBrush}" Height="1" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Не знаете, что выбрать?"
                                       Style="{StaticResource TextMutedStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="AutoPickButton"
                                    Content="Подобрать автоматически"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="AutoPick_Click" />
                        </StackPanel>
                        <TextBlock x:Name="BestHintText"
                                   Style="{StaticResource TextSubtleStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Всё остальное — по требованию. -->
            <Expander x:Name="DetailsExpander"
                      Header="Подробности"
                      Margin="0,10,0,0"
                      Visibility="Collapsed">
                <StackPanel Margin="2,10,2,0">
                    <TextBlock x:Name="StrategyDescriptionText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="PathDetailText"
                               Style="{StaticResource TextSubtleStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Text="Аргументы winws"
                               Style="{StaticResource TextLabelStyle}"
                               Margin="0,12,0,0" />
                    <TextBlock x:Name="ArgsText"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Изменить папку"
                                Style="{StaticResource SubtleButtonStyle}"
                                Margin="0,0,8,0"
                                Click="ChoosePath_Click" />
                        <Button Content="Очистить журнал"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="ClearLog_Click" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,10,0,0"
                            Padding="10">
                        <ScrollViewer x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      MaxHeight="200">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
