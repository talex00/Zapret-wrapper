<UserControl x:Class="ZapretWrapper.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Быстрый запуск"
                               Style="{StaticResource TextCardTitleStyle}" />

                    <TextBlock Text="Выберите стратегию:"
                               Style="{StaticResource TextLabelStyle}" />
                    <ComboBox x:Name="StrategyCombo"
                              DisplayMemberPath="Name"
                              SelectionChanged="StrategyCombo_SelectionChanged" />

                    <TextBlock x:Name="SourceText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock x:Name="StrategyDescriptionText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <!-- Одна кнопка вместо двух: меняет роль по состоянию winws2. -->
                    <Button x:Name="ActionButton"
                            Content="▶  Запустить обход"
                            Click="Action_Click"
                            Margin="0,16,0,0" />

                    <TextBlock x:Name="StateText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Подбор стратегии"
                               Style="{StaticResource TextCardTitleStyle}" />
                    <TextBlock x:Name="BestHintText"
                               Style="{StaticResource TextMutedStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Журнал событий"
                                   Style="{StaticResource TextCardTitleStyle}"
                                   Margin="0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SubtleButtonStyle}"
                                Content="Очистить"
                                Click="ClearLog_Click" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <ScrollViewer x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      MaxHeight="260">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
