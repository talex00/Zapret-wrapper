<UserControl x:Class="ZapretWrapper.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Журнал событий"
                       VerticalAlignment="Center"
                       Style="{StaticResource TextCardTitleStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Content="Копировать выбранное"
                        Margin="0,0,8,0"
                        Click="CopySelected_Click" />
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Content="Копировать всё"
                        Margin="0,0,8,0"
                        Click="CopyAll_Click" />
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Content="Файл журнала"
                        Margin="0,0,8,0"
                        Click="OpenFile_Click" />
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Content="Обновить"
                        Margin="0,0,8,0"
                        Click="Refresh_Click" />
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Content="Очистить"
                        Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <ListBox x:Name="LogView"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12"
                     SelectionMode="Extended"
                     PreviewKeyDown="LogView_PreviewKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- TextBox вместо TextBlock: так строку можно выделить и скопировать. -->
                        <TextBox Text="{Binding Text, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
