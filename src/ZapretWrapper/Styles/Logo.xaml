<!--
  Логотип Zapret Wrapper в виде DrawingImage.

  Почему так, а не SVG/PNG: WPF не умеет SVG из коробки, а растр мылится
  на дробном DPI. DrawingImage — это ImageSource, его можно отдать и в Window.Icon,
  и в Image.Source, и он масштабируется векторно.
  Исходник той же графики в виде SVG лежит в assets/logo.svg — править нужно оба.

  Читаемость на малых размерах: иконка живёт в заголовке окна (16-20 px),
  поэтому золотые детали не должны соприкасаться. Нос укорочен и поднят,
  под пастью проложено тёмное гало цвета щита — оно физически разрывает
  нос и пасть даже там, где антиалиасинг съедает 1-2 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="LogoShieldBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#2E62B4" Offset="0" />
        <GradientStop Color="#10306B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoGoldBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFD84E" Offset="0" />
        <GradientStop Color="#F0A81E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LogoOutlineBrush" Color="#12224A" />

    <!-- Тёмное гало: рисуется под золотыми деталями, чтобы они не сливались. -->
    <SolidColorBrush x:Key="LogoHaloBrush" Color="#14336F" />

    <DrawingImage x:Key="AppLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!-- Щит -->
                <GeometryDrawing Brush="{StaticResource LogoShieldBrush}"
                                 Geometry="M50 3 C 78 3 95 20 95 47 C 95 85 74 108 50 118 C 26 108 5 85 5 47 C 5 20 22 3 50 3 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoOutlineBrush}" Thickness="6" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Язычки гривы по краю щита -->
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M50 6 L 58 22 L 50 17 L 42 22 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M16 18 L 33 27 L 22 30 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M84 18 L 67 27 L 78 30 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M8 48 L 22 50 L 10 57 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M92 48 L 78 50 L 90 57 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M22 92 L 33 84 L 31 95 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M78 92 L 67 84 L 69 95 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M50 116 L 43 100 L 50 105 L 57 100 Z" />

                <!-- Внешнее кольцо гривы: 4 px вместо 3.5 — на 16 px тонкая линия исчезала. -->
                <GeometryDrawing Geometry="M50 22 C 68 20 82 33 84 52 C 86 72 72 90 50 101 C 28 90 14 72 16 52 C 18 33 32 20 50 22 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoGoldBrush}" Thickness="4" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Уши -->
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M33 42 C 27 33 31 27 38 31 C 41 33 43 37 42 41 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M67 42 C 73 33 69 27 62 31 C 59 33 57 37 58 41 Z" />

                <!-- Львиная маска -->
                <GeometryDrawing Geometry="M50 36 C 63 36 71 46 71 58 C 71 72 62 84 50 91 C 38 84 29 72 29 58 C 29 46 37 36 50 36 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoGoldBrush}" Thickness="5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Глаза -->
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M38 53 C 41 48 47 50 46 55 C 44 59 38 58 38 53 Z" />
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M62 53 C 59 48 53 50 54 55 C 56 59 62 58 62 53 Z" />

                <!-- Нос: короче и выше прежнего, низ на 71 вместо 76. -->
                <GeometryDrawing Brush="{StaticResource LogoGoldBrush}"
                                 Geometry="M50 60 L 56 68 L 50 72 L 44 68 Z" />

                <!-- Гало под пастью: тёмная подложка, гарантирующая разрыв с носом. -->
                <GeometryDrawing Geometry="M39 80 C 44 89 56 89 61 80">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoHaloBrush}" Thickness="9" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Пасть -->
                <GeometryDrawing Geometry="M39 80 C 44 89 56 89 61 80">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoGoldBrush}" Thickness="4" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
