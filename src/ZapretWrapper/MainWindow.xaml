<Window x:Class="ZapretWrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZapretWrapper.ViewModels"
        xmlns:views="clr-namespace:ZapretWrapper.Views"
        Title="Zapret Wrapper"
        Icon="{StaticResource AppLogo}"
        Width="880" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <!--
        Оболочка сознательно пустая: интерфейс раскрывается по мере появления данных.
        Боковое меню и служебные страницы (стратегии, тестирование, логи, настройки)
        нужны меньшинству, поэтому живут за переключателем «Расширенный режим»,
        а не занимают 220 px на старте.

        В шапке нет ни иконки, ни названия: и то и другое уже нарисовано системой
        в заголовке окна прямо над ней, дублировать их незачем. Шапка отвечает
        только за состояние обхода, возврат назад и переключение режима.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =================== SIDEBAR (расширенный режим) =================== -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Visibility="Collapsed"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,20,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource AppLogo}"
                               Width="32" Height="38"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="False" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Zapret"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Wrapper"
                                       FontSize="13"
                                       Margin="0,-2,0,0"
                                       Style="{StaticResource TextMutedStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton x:Name="NavHome"
                                 Style="{StaticResource NavItemStyle}"
                                 IsChecked="True"
                                 Checked="Nav_Checked"
                                 Tag="🏠"
                                 Content="Главная" />
                    <RadioButton x:Name="NavStrategies"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"
                                 Tag="⚙"
                                 Content="Стратегии" />
                    <RadioButton x:Name="NavTesting"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"
                                 Tag="🧪"
                                 Content="Тестирование" />
                    <RadioButton x:Name="NavLogs"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"
                                 Tag="📄"
                                 Content="Логи" />
                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked"
                                 Tag="⚙"
                                 Content="Настройки" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,12,20,20">
                    <TextBlock Text="Версия 0.1.0"
                               Style="{StaticResource TextMutedStyle}" />
                    <TextBlock Text="dev build"
                               Style="{StaticResource TextSubtleStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================== CONTENT =================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Тонкая полоса состояния вместо второй «шапки приложения». -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Content="←  На главную"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="Back_Click" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource DangerBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="Остановлено"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ProfileText"
                                   Text=""
                                   Margin="8,0,0,0"
                                   Visibility="Collapsed"
                                   Style="{StaticResource TextMutedStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="AdvancedButton"
                            Grid.Column="2"
                            Content="Расширенный режим"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="AdvancedToggle_Click" />
                </Grid>
            </Border>

            <!-- Page host -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="{DynamicResource BackgroundBrush}" />
        </Grid>
    </Grid>
</Window>
